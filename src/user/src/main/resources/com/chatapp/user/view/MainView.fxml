<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Main window shell: icon rail + content area (center is set by MainController.setContent) -->
<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatapp.user.controller.MainController">
    <fx:define>
        <ToggleGroup fx:id="railGroup"/>
    </fx:define>
    <!-- D9: hidden until V2 sees a login with a password sent by "Quên mật khẩu" -->
    <top>
        <HBox fx:id="passwordReminder" styleClass="note,warn" spacing="8" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <Label text="Bạn đang dùng mật khẩu do hệ thống gửi qua email. Hãy đổi mật khẩu mới."/>
            <Hyperlink text="Đổi mật khẩu" styleClass="small" onAction="#onProfile"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="rail" prefWidth="68">
            <Label text="CA" styleClass="logo">
                <VBox.margin><Insets bottom="12"/></VBox.margin>
            </Label>
            <ToggleButton fx:id="chatsButton" styleClass="rail-button" toggleGroup="$railGroup" onAction="#onChats">
                <graphic><FontIcon iconLiteral="fth-message-circle"/></graphic>
                <tooltip><Tooltip text="Trò chuyện"/></tooltip>
            </ToggleButton>
            <StackPane alignment="TOP_RIGHT">
                <ToggleButton fx:id="friendsButton" styleClass="rail-button" toggleGroup="$railGroup" onAction="#onFriends">
                    <graphic><FontIcon iconLiteral="fth-users"/></graphic>
                    <tooltip><Tooltip text="Bạn bè · 3 lời mời"/></tooltip>
                </ToggleButton>
                <Label text="3" styleClass="rail-count" mouseTransparent="true"/>
            </StackPane>
            <ToggleButton fx:id="searchButton" styleClass="rail-button" toggleGroup="$railGroup" onAction="#onSearchUsers">
                <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
                <tooltip><Tooltip text="Tìm người dùng"/></tooltip>
            </ToggleButton>
            <Region VBox.vgrow="ALWAYS"/>
            <ToggleButton fx:id="profileButton" styleClass="rail-button" toggleGroup="$railGroup" onAction="#onProfile">
                <graphic><Label text="AN" styleClass="avatar,sm"/></graphic>
                <tooltip><Tooltip text="Hồ sơ"/></tooltip>
            </ToggleButton>
            <Button styleClass="rail-button" onAction="#onLogout">
                <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                <tooltip><Tooltip text="Đăng xuất"/></tooltip>
            </Button>
        </VBox>
    </left>
</BorderPane>
