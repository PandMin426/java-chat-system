<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- S03 Quên mật khẩu (UC-04) -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chatapp.user.controller.ForgotPasswordController" styleClass="auth-bg">
    <VBox styleClass="auth-card" maxWidth="400" maxHeight="-Infinity">
        <VBox spacing="4">
            <Label text="Khởi tạo lại mật khẩu" styleClass="h2"/>
            <Label text="Hệ thống tạo mật khẩu ngẫu nhiên mới và gửi tới email đã đăng ký của bạn."
                   styleClass="muted" wrapText="true"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Tên đăng nhập" styleClass="small,strong"/>
            <TextField fx:id="usernameField" text="an.nguyen"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Email đã đăng ký" styleClass="small,strong"/>
            <TextField fx:id="emailField" text="an.nguyen@gmail.com"/>
            <Label text="Phải khớp với email của tài khoản." styleClass="hint"/>
        </VBox>
        <Button text="Gửi mật khẩu mới" styleClass="primary,lg" maxWidth="Infinity" defaultButton="true"/>
        <HBox alignment="CENTER">
            <Hyperlink text="Quay lại đăng nhập" styleClass="small" onAction="#onBack"/>
        </HBox>
    </VBox>
</StackPane>
