<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- D02 Báo cáo spam (UC-14). A report stores only who reported whom and when: no reason or note. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.user.controller.ReportSpamController" styleClass="dialog-root" prefWidth="460">
    <VBox styleClass="dialog-head">
        <Label text="Báo cáo spam" styleClass="h2"/>
        <Label text="Báo cáo kevin.tran tới quản trị viên. Người này không được thông báo."
               styleClass="small,muted" wrapText="true"/>
    </VBox>
    <VBox styleClass="dialog-body">
        <Label text="Quản trị viên sẽ thấy ai bị báo cáo và thời điểm báo cáo, rồi quyết định có khóa tài khoản này hay không."
               styleClass="small" wrapText="true"/>
        <CheckBox text="Chặn luôn người này" selected="true"/>
    </VBox>
    <HBox styleClass="dialog-footer">
        <Button fx:id="cancelButton" text="Hủy" cancelButton="true" onAction="#onClose"/>
        <Button text="Gửi báo cáo" styleClass="danger,primary" defaultButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
