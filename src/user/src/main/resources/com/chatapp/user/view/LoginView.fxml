<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- S01 Đăng nhập (UC-02). The error label is hidden until V2 rejects a login (wrong password, locked account). -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chatapp.user.controller.LoginController" styleClass="auth-bg">
    <VBox styleClass="auth-card" maxWidth="400" maxHeight="-Infinity">
        <Label text="CA" styleClass="logo"/>
        <VBox spacing="4">
            <Label text="Đăng nhập ChatApp" styleClass="h2"/>
            <Label text="Nhập tên đăng nhập và mật khẩu của bạn." styleClass="muted"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Tên đăng nhập" styleClass="small,strong"/>
            <TextField fx:id="usernameField" text="an.nguyen"/>
        </VBox>
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT">
                <Label text="Mật khẩu" styleClass="small,strong"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Quên mật khẩu?" styleClass="small" onAction="#onForgotPassword"/>
            </HBox>
            <PasswordField fx:id="passwordField" text="matkhau123"/>
        </VBox>
        <Label fx:id="errorLabel" text="Tài khoản đã bị khóa. Vui lòng liên hệ quản trị viên." styleClass="error-text"
               wrapText="true" visible="false" managed="false"/>
        <Button text="Đăng nhập" styleClass="primary,lg" maxWidth="Infinity" defaultButton="true" onAction="#onLogin"/>
        <HBox alignment="CENTER" spacing="4">
            <Label text="Chưa có tài khoản?" styleClass="small,muted"/>
            <Hyperlink text="Tạo tài khoản" styleClass="small" onAction="#onRegister"/>
        </HBox>
    </VBox>
</StackPane>
