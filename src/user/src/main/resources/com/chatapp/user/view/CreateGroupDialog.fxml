<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- D01 Tạo nhóm chat (UC-22). Every group is end-to-end encrypted, so there is no encryption option. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.user.controller.CreateGroupController" styleClass="dialog-root" prefWidth="500">
    <VBox styleClass="dialog-head">
        <Label text="Tạo nhóm chat" styleClass="h2"/>
        <Label text="Thêm ít nhất 1 người khác. Bạn sẽ là admin của nhóm." styleClass="small,muted"/>
    </VBox>
    <VBox styleClass="dialog-body">
        <VBox spacing="6">
            <Label text="Tên nhóm" styleClass="small,strong"/>
            <TextField text="Đồ án Java"/>
        </VBox>
        <VBox spacing="8">
            <Label fx:id="memberLabel" styleClass="small,strong"/>
            <FlowPane fx:id="chipPane" hgap="6" vgap="6"/>
            <StackPane styleClass="search" alignment="CENTER_LEFT">
                <TextField text="h" promptText="Thêm theo tên đăng nhập hoặc họ tên"/>
                <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
            </StackPane>
            <VBox fx:id="suggestionBox" styleClass="card" spacing="0"/>
        </VBox>
        <HBox styleClass="note" spacing="8" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fth-lock"/>
            <Label text="Mọi nhóm đều được mã hóa đầu cuối: chỉ thành viên giải mã được tin nhắn, máy chủ chỉ lưu bản mã."
                   wrapText="true"/>
        </HBox>
    </VBox>
    <HBox styleClass="dialog-footer">
        <Button text="Hủy" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="createButton" text="Tạo nhóm" styleClass="primary" defaultButton="true" onAction="#onCreate"/>
    </HBox>
</VBox>
