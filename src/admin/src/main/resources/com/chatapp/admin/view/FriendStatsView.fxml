<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S16 Số lượng bạn bè (UC-44: A7a–A7d) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.FriendStatsController">
    <fx:define>
        <ToggleGroup fx:id="operatorGroup"/>
    </fx:define>
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Số lượng bạn bè" styleClass="h1"/>
            <Label text="“Tính cả bạn của bạn” = số người khác nhau cách tối đa 2 bước, không tính chính người đó. Dữ liệu mẫu."
                   styleClass="small,muted"/>
        </VBox>
    </HBox>
    <HBox styleClass="toolbar">
        <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="240">
            <TextField promptText="Lọc theo tên" styleClass="sm"/>
            <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
        </StackPane>
        <Label text="Số bạn trực tiếp" styleClass="small,muted"/>
        <HBox styleClass="segmented">
            <ToggleButton text="Tất cả" styleClass="first" toggleGroup="$operatorGroup"/>
            <ToggleButton text="=" toggleGroup="$operatorGroup"/>
            <ToggleButton text="&lt;" toggleGroup="$operatorGroup"/>
            <ToggleButton text="&gt;" styleClass="last" toggleGroup="$operatorGroup" selected="true"/>
        </HBox>
        <Spinner editable="true" min="0" max="9999" initialValue="5"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="4 người phù hợp" styleClass="small,muted"/>
    </HBox>
    <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" sortable="false" prefWidth="160"/>
                <TableColumn fx:id="nameColumn" text="Họ tên" prefWidth="220"/>
                <TableColumn fx:id="createdColumn" text="Ngày tạo" prefWidth="130"/>
                <TableColumn fx:id="directColumn" text="Bạn trực tiếp" sortable="false" prefWidth="140"/>
                <TableColumn fx:id="twoHopColumn" text="Tính cả bạn của bạn" sortable="false"/>
            </columns>
        </TableView>
    </StackPane>
    <HBox styleClass="pager">
        <Label text="Ví dụ: A–B, A–C, B–D, C–D → A có 2 bạn trực tiếp, 3 khi tính cả bạn của bạn (B, C, D)."/>
    </HBox>
</VBox>
