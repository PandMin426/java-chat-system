<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S15 Người dùng đăng ký mới (UC-42: A5a–A5c list, UC-43: A6 chart) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.NewUsersController">
    <fx:define>
        <ToggleGroup fx:id="yearGroup"/>
    </fx:define>
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Người dùng đăng ký mới" styleClass="h1"/>
            <Label text="Chỉ tính tài khoản tự đăng ký; tài khoản do quản trị viên tạo không được tính. Dữ liệu mẫu." styleClass="small,muted"/>
        </VBox>
    </HBox>
    <TabPane styleClass="page-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Biểu đồ theo năm">
            <VBox>
                <HBox styleClass="toolbar">
                    <Label text="Năm" styleClass="small,muted"/>
                    <HBox styleClass="segmented">
                        <ToggleButton text="2025" styleClass="first" toggleGroup="$yearGroup" onAction="#onYear"/>
                        <ToggleButton fx:id="year2026" text="2026" styleClass="last" toggleGroup="$yearGroup" onAction="#onYear"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" styleClass="small"/>
                </HBox>
                <VBox styleClass="chart-host" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card,chart-card" VBox.vgrow="ALWAYS">
                        <Label fx:id="chartTitle" styleClass="h3"/>
                        <Label text="Rê chuột vào cột để xem số liệu. Tháng hiện tại (màu xanh) mới tính đến 08/11."
                               styleClass="xs,muted"/>
                        <BarChart fx:id="chart" legendVisible="false" animated="false" categoryGap="14" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis label="Tháng"/></xAxis>
                            <yAxis><NumberAxis label="Số tài khoản tự đăng ký"/></yAxis>
                        </BarChart>
                    </VBox>
                </VBox>
            </VBox>
        </Tab>
        <Tab text="Danh sách theo khoảng thời gian">
            <VBox>
                <HBox styleClass="toolbar">
                    <Label text="Từ" styleClass="small,muted"/>
                    <DatePicker fx:id="fromDate"/>
                    <Label text="Đến" styleClass="small,muted"/>
                    <DatePicker fx:id="toDate"/>
                    <Button text="Xem" styleClass="primary"/>
                    <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="220">
                        <TextField promptText="Lọc theo tên" styleClass="sm"/>
                        <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
                    </StackPane>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="6 người đăng ký trong khoảng" styleClass="small,muted"/>
                </HBox>
                <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
                    <TableView fx:id="table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" sortable="false" prefWidth="170"/>
                            <TableColumn fx:id="nameColumn" text="Họ tên" prefWidth="220"/>
                            <TableColumn fx:id="emailColumn" text="Email" sortable="false" prefWidth="240"/>
                            <TableColumn fx:id="createdColumn" text="Thời gian tạo"/>
                        </columns>
                    </TableView>
                </StackPane>
                <HBox styleClass="pager">
                    <Label text="Hiển thị 1–6 / 6"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
