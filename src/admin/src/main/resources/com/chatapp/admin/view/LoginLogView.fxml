<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S12 Nhật ký đăng nhập (UC-39: A2) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.LoginLogController">
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Nhật ký đăng nhập" styleClass="h1"/>
            <Label text="Mỗi dòng là một lần đăng nhập thành công, mới nhất trước."
                   styleClass="small,muted"/>
        </VBox>
    </HBox>
    <HBox styleClass="toolbar">
        <Label text="Từ" styleClass="small,muted"/>
        <DatePicker fx:id="fromDate"/>
        <Label text="Đến" styleClass="small,muted"/>
        <DatePicker fx:id="toDate"/>
        <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="260">
            <TextField promptText="Tên đăng nhập hoặc họ tên" styleClass="sm"/>
            <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
        </StackPane>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="1.932 lượt đăng nhập" styleClass="small,muted"/>
    </HBox>
    <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="timeColumn" text="Thời gian" prefWidth="180"/>
                <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" sortable="false" prefWidth="180"/>
                <TableColumn fx:id="nameColumn" text="Họ tên" sortable="false"/>
            </columns>
        </TableView>
    </StackPane>
    <HBox styleClass="pager">
        <Label text="Hiển thị 1–12 / 1.932"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Trước" styleClass="sm" disable="true"/>
        <Label text="1 / 161" styleClass="mono"/>
        <Button text="Sau" styleClass="sm"/>
    </HBox>
</VBox>
