<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S17 Người dùng hoạt động (UC-46: A8a–A8d list, A9 chart) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.ActiveUsersController">
    <fx:define>
        <ToggleGroup fx:id="metricGroup"/>
        <ToggleGroup fx:id="operatorGroup"/>
        <ToggleGroup fx:id="yearGroup"/>
    </fx:define>
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Người dùng hoạt động" styleClass="h1"/>
            <Label text="Hoạt động = có mở ứng dụng hoặc gửi tin nhắn trong khoảng thời gian. Dữ liệu mẫu."
                   styleClass="small,muted"/>
        </VBox>
    </HBox>
    <TabPane styleClass="page-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Danh sách theo khoảng thời gian">
            <VBox>
                <HBox styleClass="toolbar">
                    <Label text="Từ" styleClass="small,muted"/>
                    <DatePicker fx:id="fromDate"/>
                    <Label text="Đến" styleClass="small,muted"/>
                    <DatePicker fx:id="toDate"/>
                    <Button text="Xem" styleClass="primary"/>
                    <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="200">
                        <TextField promptText="Lọc theo tên" styleClass="sm"/>
                        <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
                    </StackPane>
                </HBox>
                <HBox styleClass="toolbar">
                    <Label text="Lọc theo" styleClass="small,muted"/>
                    <HBox styleClass="segmented">
                        <ToggleButton text="Mở ứng dụng" styleClass="first" toggleGroup="$metricGroup" selected="true"/>
                        <ToggleButton text="Chat với người" toggleGroup="$metricGroup"/>
                        <ToggleButton text="Chat nhóm" styleClass="last" toggleGroup="$metricGroup"/>
                    </HBox>
                    <HBox styleClass="segmented">
                        <ToggleButton text="Tất cả" styleClass="first" toggleGroup="$operatorGroup"/>
                        <ToggleButton text="=" toggleGroup="$operatorGroup"/>
                        <ToggleButton text="&lt;" toggleGroup="$operatorGroup"/>
                        <ToggleButton text="&gt;" styleClass="last" toggleGroup="$operatorGroup" selected="true"/>
                    </HBox>
                    <Spinner editable="true" min="0" max="9999" initialValue="5"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="5 người" styleClass="small,muted"/>
                </HBox>
                <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
                    <TableView fx:id="table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" sortable="false" prefWidth="140"/>
                            <TableColumn fx:id="nameColumn" text="Họ tên" prefWidth="190"/>
                            <TableColumn fx:id="createdColumn" text="Ngày tạo" prefWidth="120"/>
                            <TableColumn fx:id="opensColumn" text="Mở ứng dụng" sortable="false" prefWidth="130"/>
                            <TableColumn fx:id="peopleColumn" text="Chat với (người)" sortable="false" prefWidth="140"/>
                            <TableColumn fx:id="groupsColumn" text="Chat nhóm (nhóm)" sortable="false"/>
                        </columns>
                    </TableView>
                </StackPane>
                <HBox styleClass="pager">
                    <Label text="Khoảng 01/11/2026 – 08/11/2026"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Biểu đồ theo năm">
            <VBox>
                <HBox styleClass="toolbar">
                    <Label text="Năm" styleClass="small,muted"/>
                    <HBox styleClass="segmented">
                        <ToggleButton text="2025" styleClass="first" toggleGroup="$yearGroup" onAction="#onYear"/>
                        <ToggleButton fx:id="year2026" text="2026" styleClass="last" toggleGroup="$yearGroup" onAction="#onYear"/>
                    </HBox>
                </HBox>
                <VBox styleClass="chart-host" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card,chart-card" VBox.vgrow="ALWAYS">
                        <Label fx:id="chartTitle" styleClass="h3"/>
                        <Label text="Mỗi người được đếm 1 lần trong tháng dù mở ứng dụng nhiều lần. Rê chuột vào cột để xem số liệu."
                               styleClass="xs,muted"/>
                        <BarChart fx:id="chart" legendVisible="false" animated="false" categoryGap="14" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis label="Tháng"/></xAxis>
                            <yAxis><NumberAxis label="Số người có mở ứng dụng"/></yAxis>
                        </BarChart>
                    </VBox>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
