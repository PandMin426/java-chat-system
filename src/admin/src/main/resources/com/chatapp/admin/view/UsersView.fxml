<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S11 Quản lý người dùng (UC-31..37: A1a–A1f) -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.UsersController">

    <VBox HBox.hgrow="ALWAYS">
        <HBox styleClass="page-head">
            <VBox spacing="4">
                <Label text="Người dùng" styleClass="h1"/>
                <Label text="1.284 tài khoản · 37 đang online" styleClass="small,muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Thêm người dùng" styleClass="primary" onAction="#onAdd">
                <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
            </Button>
        </HBox>
        <HBox styleClass="toolbar">
            <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="260">
                <TextField promptText="Họ tên hoặc tên đăng nhập" styleClass="sm"/>
                <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
            </StackPane>
            <ComboBox>
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tài khoản: tất cả"/>
                        <String fx:value="Hoạt động"/>
                        <String fx:value="Bị khóa"/>
                    </FXCollections>
                </items>
                <value><String fx:value="Tài khoản: tất cả"/></value>
            </ComboBox>
            <ComboBox>
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Kết nối: tất cả"/>
                        <String fx:value="Online"/>
                        <String fx:value="Offline"/>
                    </FXCollections>
                </items>
                <value><String fx:value="Kết nối: tất cả"/></value>
            </ComboBox>
        </HBox>
        <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
            <TableView fx:id="table">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" sortable="false" prefWidth="160"/>
                    <TableColumn fx:id="nameColumn" text="Họ tên" prefWidth="220"/>
                    <TableColumn fx:id="createdColumn" text="Ngày tạo" prefWidth="130"/>
                    <TableColumn fx:id="statusColumn" text="Trạng thái" sortable="false" prefWidth="120"/>
                </columns>
            </TableView>
        </StackPane>
        <HBox styleClass="pager">
            <Label text="Hiển thị 1–10 / 1.284"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Trước" styleClass="sm" disable="true"/>
            <Label text="1 / 129" styleClass="mono"/>
            <Button text="Sau" styleClass="sm"/>
        </HBox>
    </VBox>

    <!-- Detail of the selected user -->
    <VBox styleClass="detail">
        <VBox styleClass="detail-head">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="initialsLabel" styleClass="avatar"/>
                <VBox>
                    <Label fx:id="nameLabel" styleClass="h3"/>
                    <Label fx:id="usernameLabel" styleClass="small,muted,mono"/>
                </VBox>
            </HBox>
            <HBox spacing="6">
                <Label fx:id="statusBadge" styleClass="badge"/>
                <Label fx:id="onlineBadge" styleClass="badge"/>
            </HBox>
            <FlowPane hgap="6" vgap="6">
                <Button text="Sửa" styleClass="sm" onAction="#onEdit"/>
                <Button text="Đặt lại mật khẩu" styleClass="sm" onAction="#onResetPassword"/>
                <Button fx:id="lockButton" styleClass="sm"/>
                <Button text="Xóa" styleClass="sm,danger"/>
            </FlowPane>
        </VBox>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="Thông tin">
                <GridPane styleClass="kv">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Email" styleClass="key" GridPane.rowIndex="0"/>
                    <Label fx:id="emailLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Giới tính" styleClass="key" GridPane.rowIndex="1"/>
                    <Label fx:id="genderLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Ngày sinh" styleClass="key" GridPane.rowIndex="2"/>
                    <Label fx:id="birthLabel" styleClass="mono" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Địa chỉ" styleClass="key" GridPane.rowIndex="3"/>
                    <Label fx:id="addressLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Ngày tạo" styleClass="key" GridPane.rowIndex="4"/>
                    <Label fx:id="createdLabel" styleClass="mono" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
            </Tab>
            <Tab text="Lịch sử đăng nhập">
                <TableView fx:id="loginTable">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="loginTimeColumn" text="Thời gian" prefWidth="150"/>
                        <TableColumn fx:id="loginIpColumn" text="Địa chỉ IP" sortable="false"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab text="Bạn bè · 12">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <VBox fx:id="friendBox"/>
                </ScrollPane>
            </Tab>
        </TabPane>
    </VBox>
</HBox>
