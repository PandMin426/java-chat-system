<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S14 Báo cáo spam (UC-41, UC-35: A4a–A4d). A report has reporter, reported user, time, reasons (D37) and status (D38). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.SpamController">
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Báo cáo spam" styleClass="h1"/>
            <Label text="Mỗi dòng là một lần báo cáo. Khóa tài khoản sẽ ngắt kết nối người đó ngay nếu đang online và chuyển mọi báo cáo về người đó sang “Đã xử lý”; “Bỏ qua” chỉ đóng báo cáo đang chọn."
                   styleClass="small,muted" wrapText="true"/>
            <!-- D12: hidden until V2 gets no ACK from ChatServer after a lock (admin_audit_log CONTROL_FAILED / CONTROL_UNKNOWN) -->
            <HBox fx:id="kickFailedNote" styleClass="note,warn" spacing="8" alignment="CENTER_LEFT"
                  visible="false" managed="false">
                <Label text="Đã khóa nhưng chưa ngắt được kết nối của người bị báo cáo." wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button text="Thử lại" styleClass="sm"/>
            </HBox>
        </VBox>
    </HBox>
    <HBox styleClass="toolbar">
        <Label text="Từ" styleClass="small,muted"/>
        <DatePicker fx:id="fromDate"/>
        <Label text="Đến" styleClass="small,muted"/>
        <DatePicker fx:id="toDate"/>
        <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="280">
            <TextField promptText="Tên đăng nhập người bị báo cáo" styleClass="sm"/>
            <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
        </StackPane>
    </HBox>
    <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="timeColumn" text="Thời gian" prefWidth="150"/>
                <TableColumn fx:id="reporterColumn" text="Người báo cáo" sortable="false" prefWidth="140"/>
                <TableColumn fx:id="reportedColumn" text="Người bị báo cáo" prefWidth="170"/>
                <TableColumn fx:id="reasonColumn" text="Lý do" sortable="false" prefWidth="300"/>
                <TableColumn fx:id="actionColumn" text="Xử lý" sortable="false"/>
            </columns>
        </TableView>
    </StackPane>
    <HBox styleClass="pager">
        <Label text="Hiển thị 1–7 / 7"/>
    </HBox>
</VBox>
