<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- S14 Báo cáo spam (UC-42, UC-43: A4a–A4d) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatapp.admin.controller.SpamController">
    <HBox styleClass="page-head">
        <VBox spacing="4">
            <Label text="Báo cáo spam" styleClass="h1"/>
            <Label text="4 báo cáo đang chờ xử lý. Khóa tài khoản sẽ ngắt kết nối người đó ngay nếu đang online."
                   styleClass="small,muted"/>
        </VBox>
    </HBox>
    <HBox styleClass="toolbar">
        <Label text="Từ" styleClass="small,muted"/>
        <DatePicker fx:id="fromDate"/>
        <Label text="Đến" styleClass="small,muted"/>
        <DatePicker fx:id="toDate"/>
        <StackPane styleClass="search" alignment="CENTER_LEFT" prefWidth="220">
            <TextField promptText="Tên đăng nhập" styleClass="sm"/>
            <FontIcon iconLiteral="fth-search" translateX="10" mouseTransparent="true"/>
        </StackPane>
        <ComboBox>
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả trạng thái"/>
                    <String fx:value="Chờ xử lý"/>
                    <String fx:value="Đã khóa"/>
                    <String fx:value="Bỏ qua"/>
                </FXCollections>
            </items>
            <value><String fx:value="Tất cả trạng thái"/></value>
        </ComboBox>
    </HBox>
    <StackPane styleClass="table-host" VBox.vgrow="ALWAYS">
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="timeColumn" text="Thời gian" prefWidth="150"/>
                <TableColumn fx:id="reportedColumn" text="Bị báo cáo" prefWidth="170"/>
                <TableColumn fx:id="reporterColumn" text="Người báo cáo" sortable="false" prefWidth="130"/>
                <TableColumn fx:id="reasonColumn" text="Lý do" sortable="false" prefWidth="170"/>
                <TableColumn fx:id="statusColumn" text="Trạng thái" sortable="false" prefWidth="110"/>
                <TableColumn fx:id="actionColumn" text="Xử lý" sortable="false" prefWidth="210"/>
            </columns>
        </TableView>
    </StackPane>
    <HBox styleClass="pager">
        <Label text="Hiển thị 1–7 / 7"/>
    </HBox>
</VBox>
